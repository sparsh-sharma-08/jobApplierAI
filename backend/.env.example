# ---------------------------------------------------------------------------
# Backend Environment Configuration
# Copy this file to .env and configure values before starting the application
# ---------------------------------------------------------------------------

# Database Configuration
# Local SQLite: sqlite:///./data/career_copilot.db
# PostgreSQL (Docker/Prod): postgresql://postgres:postgres@localhost:5432/career_copilot
DATABASE_URL=sqlite:///./data/career_copilot.db

# Authentication & Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
FRONTEND_URL=http://localhost:3000

# LLM Provider Configuration
# Supported providers: Ollama (local) or OpenAI API
OPENAI_API_KEY=ollama-dummy-key
LLM_MODEL=gemma3:12b
LLM_BASE_URL=http://localhost:11434/v1

# Celery Task Queue & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# SMTP Email Verification & Alerts (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=copilotcarrier@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=copilotcarrier@gmail.com

# Scraper & Rate Limit Controls
DAILY_LIMIT=20
OUTPUT_DIR=./data/resumes
